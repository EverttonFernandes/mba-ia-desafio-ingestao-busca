# Copie para .env e preencha uma senha local antes de subir o banco.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# OpenAI: configuracao da RAGT-002; chave somente no .env local.

# Login da interface web; independente das credenciais do PostgreSQL.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini-2025-04-14

# Agrupamento logico dos chunks do PDF no PostgreSQL.
PGVECTOR_COLLECTION=document_pdf
